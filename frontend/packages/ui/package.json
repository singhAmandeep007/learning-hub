{
  "name": "@learning-hub/ui",
  "version": "0.1.0",
  "description": "Learning Hub UI component library",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "scss",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./scss/tokens": "./scss/tokens.scss"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.511.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-links": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^29.0.1",
    "npm-run-all": "^4.1.5",
    "sass": "^1.98.0",
    "storybook": "^10.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  },
  "scripts": {
    "clean": "rm -rf dist storybook-static",
    "check:sass-tokens": "node scripts/check-sass-tokens.mjs",
    "build:styles": "sass src/styles/index.scss dist/styles.css --no-source-map",
    "build:ts": "tsup",
    "build": "npm run clean && npm run check:sass-tokens && npm run build:ts && npm run build:styles",
    "dev:ts": "tsup --watch --no-clean",
    "dev:styles": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && sass --watch src/styles/index.scss:dist/styles.css --no-source-map",
    "dev": "run-p dev:ts dev:styles",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run check:sass-tokens && npm run typecheck && npm run test && npm run build",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run validate"
  }
}
